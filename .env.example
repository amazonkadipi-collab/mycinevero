# Public site URL
NEXT_PUBLIC_SITE_URL="https://cinevero.vercel.app"

# TMDB server-side Bearer token. Never expose or commit the real value.
TMDB_READ_ACCESS_TOKEN=""

# Google Search Console — server-only service account credentials.
# NEVER prefix these with NEXT_PUBLIC_.
GOOGLE_SERVICE_ACCOUNT_EMAIL="cinevero-vercel-app@calculator-506922.iam.gserviceaccount.com"
# Paste the private key from the downloaded Google JSON. In .env.local it may be quoted
# with \n escapes; the server converts those escapes to real newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_NEW_ROTATED_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SEARCH_CONSOLE_SITE_URL="https://cinevero.vercel.app/"

# Admin dashboard protection. Use a long unique password in Vercel.
ADMIN_DASHBOARD_USER="admin"
ADMIN_DASHBOARD_PASSWORD="REPLACE_WITH_LONG_RANDOM_PASSWORD"

# IndexNow. The public key file must match INDEXNOW_KEY if you override it.
INDEXNOW_KEY="cinevero-indexnow-2026"
INDEXNOW_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Cinevero admin traffic analytics — server-only Vercel read token.
# Use a Vercel token with the narrowest read scope that can access Web Analytics.
VERCEL_ANALYTICS_TOKEN=""
VERCEL_TEAM_ID="team_AMXeRqHf1n1RIJA61j2463EU"
VERCEL_PROJECT_ID="prj_7YHhwmYx70AVZqSzcOXy4I9pge2M"
