# Public site URL
NEXT_PUBLIC_SITE_URL="https://watchmovies4.vercel.app"

# TMDB server-side Bearer token. Never expose or commit the real value.
TMDB_READ_ACCESS_TOKEN=""

# Supabase server-only settings
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY="YOUR_SERVER_ONLY_KEY"

# Optional admin/analytics settings used by legacy administration tools
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME"
ANALYTICS_HASH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# Optional Vercel Cron protection for the TMDB sync endpoint
CRON_SECRET=""
