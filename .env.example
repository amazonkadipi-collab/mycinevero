# Server-side Supabase credentials
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY="YOUR_SERVER_ONLY_KEY"

# Admin login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME"

# Optional secret used to hash visitor IPs without storing raw IP addresses
ANALYTICS_HASH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
